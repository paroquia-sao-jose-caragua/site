{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "site-staging",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "site-staging",
      "workers_dev": false,
      "preview_urls": false,
      "keep_names": true,
      "route": {
        "custom_domain": true,
        "pattern": "site-staging.paroquiasaojosecaragua.org.br",
        "zone_name": "paroquiasaojosecaragua.org.br",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
      },
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "site-staging",
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
    "production": {
      "name": "site",
      "workers_dev": false,
      "preview_urls": false,
      "keep_names": true,
      "route": {
        "custom_domain": true,
        "pattern": "site.paroquiasaojosecaragua.org.br",
        "zone_name": "paroquiasaojosecaragua.org.br",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
      },
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "site",
        },
      ],
      "observability": {
        "enabled": false,
      },
    },
  },
}
